# Variables d'environnement pour PokéScan

# =====================================
# Google Cloud Vision API (Optionnel)
# =====================================
# Pour utiliser Google Vision API au lieu de Tesseract.js, vous devez :
# 1. Créer un projet sur Google Cloud Console (https://console.cloud.google.com)
# 2. Activer l'API Cloud Vision
# 3. Créer une clé de service et télécharger le fichier JSON
# 4. Copier le contenu du fichier JSON dans cette variable (sur une seule ligne)
#
# Note: Sans cette configuration, l'app utilisera Tesseract.js (gratuit, côté client)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"..."}

# =====================================
# Pokemon TCG API (Optionnel)
# =====================================
# Pour obtenir une clé API et augmenter les limites de requêtes :
# https://dev.pokemontcg.io/
VITE_POKEMON_TCG_API_KEY=your_pokemon_tcg_api_key_here

# =====================================
# eBay Scraper (Cloudflare Worker)
# =====================================
# URL du Cloudflare Worker pour scraper les ventes eBay terminées
# Voir cloudflare-worker/README.md pour le déploiement
# Exemple: https://ebay-scraper.votre-subdomain.workers.dev/scrape-ebay
VITE_EBAY_SCRAPER_URL=https://ebay-scraper.YOUR-SUBDOMAIN.workers.dev/scrape-ebay

# =====================================
# eBay API Officielle (Alternative)
# =====================================
# Si vous préférez utiliser l'API eBay officielle au lieu du scraper
VITE_EBAY_APP_ID=your-ebay-app-id
VITE_EBAY_OAUTH_TOKEN=your-oauth-token
